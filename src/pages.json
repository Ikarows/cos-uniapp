{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  // pages 里只存放tabber页面和登录页面
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "cos-uniapp"
			}
		},
    {
      "path": "pages/user/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/password",
      "style": {
        "navigationBarTitleText": "密码登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/phone",
      "style": {
        "navigationBarTitleText": "手机号登录",
        "navigationStyle": "custom"
      }
    }
	],

  "subPackages": [
    {
      "root": "pages/users",
      "pages": [
        {
          "path": "user_info/index",
          "style": {
            "navigationBarTitleText": "用户信息"
          }
        },
        {
          "path": "agreement/index",
          "style": {
            "navigationBarTitleText": "用户协议"
          }
        },
        {
          "path": "privacy/index",
          "style": {
            "navigationBarTitleText": "隐私政策"
          }
        },
        {
          "path": "settings/index",
          "style": {
            "navigationBarTitleText": "系统设置"
          }
        },
        {
          "path": "about_us/index",
          "style": {
            "navigationBarTitleText": "关于我们"
          }
        },
        {
          "path": "company_intro/index",
          "style": {
            "navigationBarTitleText": "公司介绍"
          }
        }
      ]
    }
  ],

  "tabBar": {
		"color": "#7A7E83",
		"selectedColor": "#ff3366",
		"borderStyle": "white",
		"backgroundColor": "#F8F8F8",
		"list": [{
				"pagePath": "pages/index/index",
				"iconPath": "static/img/tab/tab-home.png",
				"selectedIconPath": "static/img/tab/tab-home-active.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/user/index",
				"iconPath": "static/img/tab/tab-user.png",
				"selectedIconPath": "static/img/tab/tab-user-active.png",
				"text": "我的"
			}
		]
	},

	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "加载中",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},

  "condition" : { //模式配置，仅开发期间生效
    "current": 0, //当前激活的模式(list 的索引项)
    "list": [
      {
        "name": "", //模式名称
        "path": "", //启动页面，必选
        "query": "" //启动参数，在页面的onLoad函数里面得到
      }
    ]
  }
}
